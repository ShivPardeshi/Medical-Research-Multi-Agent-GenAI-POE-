# ========================================================
# MediResearch AI — Environment Configuration Template
# ========================================================

# Model Provider selection: "google" (recommended) or "groq"
MODEL_PROVIDER=google

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (Optional fallback, get free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Server Settings
HOST=127.0.0.1
PORT=8000
REQUEST_TIMEOUT=90

